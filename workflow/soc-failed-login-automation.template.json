      "id": "82dac8c9-5e2a-42fe-b04b-e1c3c3243825",
      "name": "HTTP Request1"
    },
    {
      "parameters": {
        "jsCode": "\nconst response = $input.first().json;\n\n// Splunk returns the events inside the \"results\" array.\nconst events = response.results || [];\n\nconst threshold = 5;\nconst windowMinutes = 15;\n\nif (events.length === 0) {\n  return [{\n    json: {\n      alert: false,\n      failed_attempts: 0,\n      threshold,\n      window_minutes: windowMinutes,\n      reason: \"No failed-login events returned by Splunk\"\n    }\n  }];\n}\n\n// Count failed logins by host, username and source IP.\nconst groups = {};\n\nfor (const event of events) {\n  const message = event.Message || \"\";\n\n  const username =\n    message.match(/Account Name:\\s*([^\\r\\n]+)/i)?.[1]?.trim() ||\n    event.Account_Name ||\n    \"Unknown\";\n\n  const host = event.host || \"Unknown\";\n\n  const sourceIp =\n    message.match(/Source Network Address:\\s*([^\\r\\n]+)/i)?.[1]?.trim() ||\n    event.Source_Network_Address ||\n    \"Unknown\";\n\n  const time = Date.parse(event._time || event.event_time);\n\n  const key = `${host}|${username}|${sourceIp}`;\n\n  if (!groups[key]) {\n    groups[key] = { host, username, source_ip: sourceIp, times: [] };\n  }\n\n  if (Number.isFinite(time)) {\n    groups[key].times.push(time);\n  }\n}\n\nconst detections = [];\n\nfor (const group of Object.values(groups)) {\n  group.times.sort((a, b) => a - b);\n\n  let left = 0;\n  let maxCount = 0;\n\n  for (let right = 0; right < group.times.length; right++) {\n    while (\n      group.times[right] - group.times[left] >\n      windowMinutes * 60 * 1000\n    ) {\n      left++;\n    }\n\n    maxCount = Math.max(maxCount, right - left + 1);\n  }\n\n  detections.push({\n    host: group.host,\n    username: group.username,\n    source_ip: group.source_ip,\n    failed_attempts: maxCount,\n    threshold,\n    window_minutes: windowMinutes,\n    alert: maxCount >= threshold\n  });\n}\n\nreturn detections.map(detection => ({ json: detection }));\n"
      },
      "type": "n8n-nodes-base.code",
